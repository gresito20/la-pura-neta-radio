{
  "name": "la-pura-neta-radio",
  "version": "1.0.0",
  "description": "App oficial de La Pura Neta Radio para Android y iOS",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --port=3000 --open=/mobile-preview.html --ignore=node_modules,android,ios,.git,.vercel",
    "dev:web": "live-server --port=3000 --open=/index.html --ignore=node_modules,android,ios,.git,.vercel",
    "build": "node scripts/build-mobile.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:copy": "npm run build && npx cap copy",
    "assets:generate": "npx @capacitor/assets generate --iconBackgroundColor #000000 --splashBackgroundColor #000000"
  },
  "keywords": [
    "radio",
    "regional-mexicano",
    "streaming",
    "la-pura-neta",
    "capacitor",
    "android",
    "ios"
  ],
  "author": "La Pura Neta Radio",
  "license": "ISC",
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "live-server": "^1.2.2"
  }
}
